<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editPostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/editPostScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/editPostContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/editPostText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:hint="@string/post_text_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="120dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray"
                android:textSize="16sp" />

            <FrameLayout
                android:id="@+id/editPostAttachmentBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/editPostAttachmentPreview"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/bg_attachment"
                    android:contentDescription="@string/attachment_placeholder"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/editPostAttachmentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textColor="@color/gray"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editPostRemoveAttachment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/purple_500"
                    android:minWidth="120dp"
                    android:text="@string/btn_remove"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/editPostLocationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/gray"
                android:visibility="gone" />

            <TextView
                android:id="@+id/editPostSelectedMentions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/gray"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/editPostProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/purple_500"
                android:visibility="gone" />

            <TextView
                android:id="@+id/editPostError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/red"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/editPostToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/input_fill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/editPostPhotoButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_photo"
            android:src="@drawable/ic_camera_24"
            android:tint="@color/black" />

        <ImageButton
            android:id="@+id/editPostAttachButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attachment_placeholder"
            android:src="@drawable/ic_attach_24"
            android:tint="@color/black" />

        <ImageButton
            android:id="@+id/editPostMentionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_mention"
            android:src="@drawable/ic_people_24"
            android:tint="@color/black" />

        <ImageButton
            android:id="@+id/editPostLocationButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_location"
            android:src="@drawable/ic_location_24"
            android:tint="@color/black" />
    </LinearLayout>
</LinearLayout>
