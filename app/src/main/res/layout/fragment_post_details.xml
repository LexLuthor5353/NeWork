<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/postDetailsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/postDetailsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/postDetailsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/postDetailsAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/author_name"
                android:src="@drawable/bg_avatar" />

            <LinearLayout
                android:id="@+id/postDetailsAuthorBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/postDetailsAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="@string/author_name" />

                <TextView
                    android:id="@+id/postDetailsPublished"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    tools:text="@string/published_date" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/postDetailsMenuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_edit"
                android:src="@drawable/ic_more_vert_24"
                android:tint="@color/gray" />
        </LinearLayout>

        <TextView
            android:id="@+id/postDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="16sp"
            tools:text="@string/post_content" />

        <ImageView
            android:id="@+id/postDetailsAttachmentImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_attachment"
            android:contentDescription="@string/attachment_placeholder"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/postDetailsAttachmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/purple_500"
            android:visibility="gone"
            tools:text="@string/attachment_placeholder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/postDetailsLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/purple_700"
            android:visibility="gone"
            tools:text="@string/link_placeholder"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/postDetailsLikeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/postDetailsLikeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_like"
                android:src="@drawable/ic_like_outlined_24"
            android:tint="@color/gray" />

            <TextView
                android:id="@+id/postDetailsLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/likes_count" />
        </LinearLayout>

        <TextView
            android:id="@+id/postDetailsLikedByTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/liked_by"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/postDetailsLikedByList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/postDetailsJobTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/last_job"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/postDetailsJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="@string/looking_for_job" />

        <TextView
            android:id="@+id/postDetailsMentionedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mentioned_users"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/postDetailsMentionedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/postDetailsMapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/map_placeholder"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/postDetailsMapContainer"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_attachment">

            <TextView
                android:id="@+id/postDetailsMapStub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/map_placeholder"
                android:textColor="@color/gray" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
