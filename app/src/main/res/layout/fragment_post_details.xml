<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/postDetailsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/postDetailsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/postDetailsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/postDetailsAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/author_name"
                android:src="@drawable/bg_avatar" />

            <LinearLayout
                android:id="@+id/postDetailsAuthorBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/postDetailsAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="@string/author_name" />

                <TextView
                    android:id="@+id/postDetailsAuthorJob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gray"
                    android:textSize="14sp"
                    tools:text="Android Developer" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/postDetailsAttachmentImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_attachment"
            android:contentDescription="@string/attachment_placeholder"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/postDetailsAttachmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/purple_500"
            android:visibility="gone"
            tools:text="@string/attachment_placeholder" />

        <TextView
            android:id="@+id/postDetailsPublished"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/gray"
            android:textSize="13sp"
            tools:text="@string/published_date" />

        <TextView
            android:id="@+id/postDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/black"
            android:textSize="15sp"
            tools:text="@string/post_content" />

        <TextView
            android:id="@+id/postDetailsLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/purple_700"
            android:visibility="gone"
            tools:text="@string/link_placeholder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/postDetailsLikesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Лайки"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/postDetailsLikesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/postDetailsLikeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/btn_like"
                android:src="@drawable/ic_like_outlined_24" />

            <TextView
                android:id="@+id/postDetailsLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/black"
                android:textSize="15sp"
                tools:text="10" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/postDetailsLikesAvatars"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/postDetailsLikesMore"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_plus_circle"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="+2"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/postDetailsMentionedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Упомянутые"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/postDetailsMentionedRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/postDetailsMentionedIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/mentioned_users"
                android:src="@drawable/ic_people_24"
                app:tint="@color/purple_500" />

            <TextView
                android:id="@+id/postDetailsMentionedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/black"
                android:textSize="15sp"
                tools:text="2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/postDetailsMentionedAvatars"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/postDetailsMapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/map_placeholder"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/postDetailsMapContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/postDetailsMapStub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/map_placeholder"
                android:textColor="@color/gray" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
