<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/postCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/postAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/author_name"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/postAuthorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/postMenuButton"
            app:layout_constraintStart_toEndOf="@id/postAvatar"
            app:layout_constraintTop_toTopOf="@id/postAvatar"
            tools:text="@string/author_name" />

        <TextView
            android:id="@+id/postPublished"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/gray"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/postMenuButton"
            app:layout_constraintStart_toEndOf="@id/postAvatar"
            app:layout_constraintTop_toBottomOf="@id/postAuthorName"
            tools:text="@string/published_date" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postMenuButton"
            style="@style/Widget.NeWork.MenuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/menu_edit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/postHeaderBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="postAvatar,postPublished,postMenuButton" />

        <FrameLayout
            android:id="@+id/postAttachmentBlock"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/postHeaderBarrier"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/postAttachmentImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_attachment"
                android:contentDescription="@string/attachment_placeholder"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/postPlayIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_play"
                android:contentDescription="@string/btn_video"
                android:padding="12dp"
                android:src="@drawable/ic_play_24"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/postAttachmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/purple_500"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/postHeaderBarrier"
            tools:text="@string/attachment_placeholder" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/postMediaBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="postAttachmentBlock,postAttachmentLabel" />

        <TextView
            android:id="@+id/postText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/postMediaBarrier"
            tools:text="@string/post_content" />

        <TextView
            android:id="@+id/postLink"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/purple_700"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/postText"
            tools:text="@string/link_placeholder"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/postContentBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="postText,postAttachmentBlock,postAttachmentLabel,postLink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postLikeButton"
            style="@style/Widget.NeWork.LikeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:checkable="true"
            android:contentDescription="@string/btn_like"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/postContentBarrier"
            tools:text="@string/likes_count" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postShareButton"
            style="@style/Widget.NeWork.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/btn_share"
            android:text=""
            app:icon="@drawable/ic_share_24"
            app:layout_constraintStart_toEndOf="@id/postLikeButton"
            app:layout_constraintTop_toTopOf="@id/postLikeButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
