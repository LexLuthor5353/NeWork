<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/eventDetailsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/eventDetailsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/eventDetailsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/eventDetailsAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/author_name"
                android:src="@drawable/bg_avatar" />

            <LinearLayout
                android:id="@+id/eventDetailsAuthorBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/eventDetailsAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="@string/author_name" />

                <TextView
                    android:id="@+id/eventDetailsPublished"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    tools:text="@string/published_date" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/eventDetailsMenuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_edit"
                android:src="@drawable/ic_more_vert_24"
                app:tint="@color/gray" />
        </LinearLayout>

        <TextView
            android:id="@+id/eventDetailsDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/purple_700"
            tools:text="@string/event_date" />

        <TextView
            android:id="@+id/eventDetailsType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="@string/event_type_online" />

        <TextView
            android:id="@+id/eventDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="16sp"
            tools:text="@string/event_content" />

        <ImageView
            android:id="@+id/eventDetailsAttachmentImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_attachment"
            android:contentDescription="@string/attachment_placeholder"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/eventDetailsAttachmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/purple_500"
            android:visibility="gone"
            tools:text="@string/attachment_placeholder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/eventDetailsLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/purple_700"
            android:visibility="gone"
            tools:text="@string/link_placeholder"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/eventDetailsLikeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/eventDetailsLikeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_like"
                android:src="@drawable/ic_like_outlined_24"
                app:tint="@color/gray" />

            <TextView
                android:id="@+id/eventDetailsLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/likes_count" />
        </LinearLayout>

        <TextView
            android:id="@+id/eventDetailsJobTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/last_job"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventDetailsJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="@string/looking_for_job" />

        <TextView
            android:id="@+id/eventDetailsParticipantsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/participants"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/eventDetailsParticipantsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/eventDetailsSpeakersTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/speakers"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/eventDetailsSpeakersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/eventDetailsMapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/map_placeholder"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/eventDetailsMapContainer"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_attachment">

            <TextView
                android:id="@+id/eventDetailsMapStub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/map_placeholder"
                android:textColor="@color/gray" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
