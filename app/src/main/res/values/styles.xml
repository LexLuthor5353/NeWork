<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.NeWork.ActionButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="iconTint">@color/gray</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Widget.NeWork.LikeButton" parent="Widget.NeWork.ActionButton">
        <item name="icon">@drawable/ic_like</item>
        <item name="iconTint">@color/like_icon_tint</item>
        <item name="android:checkable">true</item>
    </style>

    <style name="Widget.NeWork.MenuButton" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="icon">@drawable/ic_more_vert_24</item>
        <item name="iconTint">@color/gray</item>
        <item name="android:text">@null</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

</resources>
